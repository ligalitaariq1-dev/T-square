{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["organization-website/**"]
      }
    }
  ],
  "routes": [
    { "src": "/gemini", "dest": "api/index.js" },
    { "src": "/contact", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}

